---
import "../styles/global.css";
import PostHog from "./PostHog.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import TopBanner from "./TopBanner.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const {
  title = "Conheça o Commander 2x2",
  description = "Um novo formato competitivo de Commander em duplas acessível e diverso.",
  keywords = "Magic: the Gathering, Commander, 2x2, formato competitivo, duplas, EDH",
}: Props = Astro.props;

const siteName = "Commander 2x2";
const author = "Guilherme de Oliveira Costa";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Astro.site is set in astro.config.mjs; resolve relative paths against it so
// canonical, og:url and og:image are always absolute and on our own domain.
const site = Astro.site!;
// Drop the trailing slash (except on "/") to match the links in nav and sitemap.
const canonicalUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), site).href;
const imageUrl = new URL("/og-image.png", site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: fullTitle,
  description,
  url: canonicalUrl,
  image: imageUrl,
  author: { "@type": "Organization", name: author },
  publisher: {
    "@type": "Organization",
    name: siteName,
    logo: { "@type": "ImageObject", url: new URL("/favicon.svg", site).href },
  },
};
---

<!doctype html>
<html lang="pt-BR" data-theme="custom">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Basic SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content="@commander2x2" />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen bg-base-100 text-base-content">
    <TopBanner
      title="Apoie o Commander 2x2!"
      description="Contribua e receba recompensas"
      link="https://apoia.se/commander2x2"
      linkText="Apoie"
    />

    <PostHog />
    <SpeedInsights />

    <Header />
    <slot />
    <Footer />
  </body>
</html>
