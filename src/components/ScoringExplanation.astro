---
import { Calendar, Trophy, Equal, Info, Gift, Ticket } from "@lucide/astro";
import { POINTS } from "../schemas/leaderboard";

export interface Props {
  // The season's points goal (meta). Absent for seasons without one.
  goalPoints?: number;
}

const { goalPoints }: Props = Astro.props;

// Full class names so Tailwind can find them.
const rules = [
  {
    icon: Calendar,
    points: POINTS.attendance,
    label: "Participação",
    bg: "bg-primary/10",
    text: "text-primary",
  },
  { icon: Trophy, points: POINTS.win, label: "Vitória", bg: "bg-success/10", text: "text-success" },
  { icon: Equal, points: POINTS.draw, label: "Empate", bg: "bg-info/10", text: "text-info" },
];
---

<div class="not-prose">
  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h3 class="card-title text-primary gap-2">
        <Info size={24} />
        Como funciona a pontuação?
      </h3>

      <p class="text-base-content/80 mb-4">
        A cada evento que você participa, inclusive os de Pre-Cons, você acumula pontos para o
        ranking da temporada. O ranking classifica os 4 melhores jogadores para a final, no último
        evento da temporada, e os campeões são os dois que mais vencem na final.
      </p>

      <div class="grid grid-cols-3 gap-4">
        {
          rules.map((rule) => (
            <div class="flex flex-col sm:flex-row items-center gap-3 p-4 bg-base-100 rounded-lg">
              <div class:list={[rule.bg, "p-3 rounded-full"]}>
                <rule.icon size={24} class={rule.text} />
              </div>
              <div class="text-center md:text-left">
                <div class:list={["text-2xl font-bold", rule.text]}>+{rule.points}</div>
                <div class="text-sm text-base-content/70">{rule.label}</div>
              </div>
            </div>
          ))
        }
      </div>

      {
        goalPoints && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <div class="flex items-start gap-3 p-4 bg-base-100 rounded-lg">
              <div class="bg-warning/10 p-3 rounded-full">
                <Gift size={24} class="text-warning" />
              </div>
              <div>
                <div class="font-bold">Meta: {goalPoints} pontos</div>
                <p class="text-sm text-base-content/70">
                  Quem fizer {goalPoints} pontos no semestre ganha um brinde garantido.{" "}
                  <span class="badge badge-outline badge-sm">brinde a definir</span>
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 bg-base-100 rounded-lg">
              <div class="bg-secondary/10 p-3 rounded-full">
                <Ticket size={24} class="text-secondary" />
              </div>
              <div>
                <div class="font-bold">Sorteio: 1 ponto = 1 bilhete</div>
                <p class="text-sm text-base-content/70">
                  No dia da final, quem não bateu a meta nem está no Top 4 concorre a um sorteio. Só
                  leva quem estiver presente.
                </p>
              </div>
            </div>
          </div>
        )
      }

      <p class="text-sm text-base-content/70 mt-4">
        Desempate: mais eventos e, depois, aproveitamento (vitórias ÷ partidas). Mais detalhes nas{
          " "
        }
        <a href="#perguntas-frequentes" class="link link-primary">perguntas frequentes</a>.
      </p>
    </div>
  </div>
</div>
