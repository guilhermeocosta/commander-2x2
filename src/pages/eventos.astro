---
import BaseLayout from "../components/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import EventCard from "../components/EventCard.astro";
import Button from "../components/Button.astro";
import { eventsData } from "../data";
import { splitEvents } from "../schemas/event";

const { upcoming: upcomingEvents, past: pastEvents } = splitEvents(eventsData.events);
import { Info } from "@lucide/astro";
---

<BaseLayout
  title="Eventos"
  description="Calendário de torneios e eventos de Commander 2x2. Participe dos torneios competitivos em duplas e conheça a comunidade."
  type="website"
  keywords="Commander 2x2, eventos, torneios, competitivo, duplas, Magic: the Gathering, EDH"
>
  <Header />

  <main class="container mx-auto px-4 py-16">
    <div class="prose prose-base lg:prose-lg mx-auto">
      <h1>Eventos</h1>

      <p>
        Participe dos torneios de Commander 2x2! Realizamos eventos mensais para testar o formato e
        conhecer novos jogadores.
      </p>

      <section class="mb-12">
        <h2>Próximos Eventos</h2>

        {
          upcomingEvents.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {upcomingEvents.map((event) => (
                <EventCard
                  title={event.title}
                  date={event.date}
                  time={event.time}
                  location={event.location}
                  format={event.format}
                  entryFee={event.entryFee}
                  description={event.description}
                />
              ))}
            </div>
          ) : (
            <div class="alert alert-info">
              <Info class="shrink-0 size-6" aria-hidden="true" />
              <span>Nenhum evento agendado no momento. Fique de olho para novidades!</span>
            </div>
          )
        }
      </section>

      {
        pastEvents.length > 0 && (
          <section>
            <h2>Eventos Anteriores</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {pastEvents.map((event) => (
                <EventCard
                  title={event.title}
                  date={event.date}
                  time={event.time}
                  location={event.location}
                  format={event.format}
                  entryFee={event.entryFee}
                  description={event.description}
                />
              ))}
            </div>
          </section>
        )
      }

      <section class="mt-16">
        <div class="card bg-base-200 shadow-xl">
          <div class="card-body text-center">
            <h2 class="card-title text-primary justify-center">Quer organizar um evento?</h2>
            <p>Entre em contato conosco para trazer um torneio de Commander 2x2 para sua cidade!</p>

            <div class="card-actions justify-center mt-4">
              <Button href="mailto:admin@commander2x2.org" className="no-underline">
                Propor Evento
              </Button>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
