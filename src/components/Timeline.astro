---
import type { MDXInstance } from "astro";

interface ChangelogEntry {
  slug: string;
  title: string;
  date: string;
  content: MDXInstance<Record<string, never>>["Content"];
  path: string;
}

export interface Props {
  entries: ChangelogEntry[];
}

const { entries }: Props = Astro.props;
import { Info } from "@lucide/astro";
---

<div class="timeline timeline-vertical">
  {
    entries.map((entry, index) => (
      <div class={`timeline-item ${index < entries.length - 1 ? "timeline-end" : ""}`}>
        <div class="timeline-middle">
          <div class="timeline-marker bg-primary border-primary" />
        </div>
        <div class="timeline-content timeline-box bg-base-100 shadow-xl mb-8">
          <div class="card-body">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
              <h2 class="card-title text-primary">{entry.title}</h2>
              <time class="badge badge-outline" datetime={entry.date}>
                {new Date(entry.date + "T00:00:00").toLocaleDateString("pt-BR")}
              </time>
            </div>
            <div class="prose prose-sm max-w-none">
              <entry.content />
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>

{
  entries.length === 0 && (
    <div class="alert alert-info">
      <Info class="shrink-0 size-6" aria-hidden="true" />
      <span>Nenhuma atualização registrada ainda.</span>
    </div>
  )
}
