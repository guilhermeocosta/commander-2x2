---
import { Image } from "astro:assets";
import { Calendar, User } from "@lucide/astro";
import Button from "./Button.astro";

export interface Props {
  url: string;
  images: string[];
  commander: string;
  date: string;
  player: string;
  /** Load images eagerly (the first cards above the fold). */
  eager?: boolean;
  /**
   * Visual-only copy used to make the carousel loop seamlessly. Hidden from
   * assistive tech and removed from the tab order so each deck is announced
   * and focused once; mouse hover still works.
   */
  decorative?: boolean;
}

const { url, images, commander, date, player, eager = false, decorative = false } = Astro.props;

const imageClass = "h-72 rounded-lg transition-all duration-700 ease-out object-cover";
const imageStyle = "filter: blur(10px); transform: scale(1.025);";
const onload = "this.style.filter='blur(0px)'; this.style.transform='scale(1)';";
const onerror = "this.style.filter='blur(2px)'; this.style.transform='scale(1.05)';";
const loading = eager ? "eager" : "lazy";
---

<div
  class="group relative shrink-0 rounded-t-lg focus:outline-none focus:ring-4 focus:ring-primary focus:ring-offset-2"
  role="group"
  aria-label={decorative ? undefined : `Deck de ${commander}, por ${player}`}
  aria-hidden={decorative ? "true" : undefined}
  tabindex={decorative ? -1 : 0}
>
  <div
    class="relative rounded-lg overflow-hidden translate-y-16 transition-transform duration-300 ease-out group-hover:translate-y-0 group-focus:translate-y-0"
  >
    <div class="relative h-72">
      <Image
        class:list={[imageClass, "-z-10"]}
        style={imageStyle}
        onload={onload}
        onerror={onerror}
        src={images[0]}
        alt={`Deck de ${commander}`}
        width={206}
        height={288}
        loading={loading}
      />
      {
        images[1] && (
          <Image
            class:list={[
              imageClass,
              "absolute top-0 left-0 translate-y-8 group-hover:translate-y-20 group-focus:translate-y-20",
            ]}
            style={imageStyle}
            onload={onload}
            onerror={onerror}
            src={images[1]}
            alt={`Deck de ${commander}`}
            width={206}
            height={288}
            loading={loading}
          />
        )
      }
    </div>

    <div
      class="absolute inset-x-0 bottom-0 p-3 pt-6 opacity-0 translate-y-2 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-focus:opacity-100 group-focus:translate-y-0 pointer-events-none"
    >
      <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/90 to-transparent">
      </div>
      <div class="relative pointer-events-auto">
        <ul class="space-y-1 mb-2">
          <li class="text-white text-xs flex items-center gap-2">
            <Calendar size={16} aria-hidden="true" />
            {new Date(date + "T00:00:00").toLocaleDateString("pt-BR")}
          </li>
          <li class="text-white text-sm flex items-center gap-2">
            <User size={16} aria-hidden="true" />
            {player}
          </li>
        </ul>

        <Button
          href={url}
          target="_blank"
          size="sm"
          className="w-full"
          rel="noopener noreferrer"
          tabindex={decorative ? -1 : undefined}
        >
          Ver deck
        </Button>
      </div>
    </div>
  </div>
</div>
