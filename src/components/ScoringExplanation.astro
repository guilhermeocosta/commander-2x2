---
import { Calendar, Trophy, Equal, Info } from "@lucide/astro";
import { POINTS } from "../schemas/leaderboard";

// Full class names so Tailwind can find them.
const rules = [
  {
    icon: Calendar,
    points: POINTS.attendance,
    label: "Participação",
    bg: "bg-primary/10",
    text: "text-primary",
  },
  { icon: Trophy, points: POINTS.win, label: "Vitória", bg: "bg-success/10", text: "text-success" },
  { icon: Equal, points: POINTS.draw, label: "Empate", bg: "bg-info/10", text: "text-info" },
];
---

<div class="not-prose">
  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <h3 class="card-title text-primary gap-2">
        <Info size={24} />
        Como funciona a pontuação?
      </h3>

      <p class="text-base-content/80 mb-4">
        A cada evento que você participa, você acumula pontos para o ranking anual. Os 4 melhores
        jogadores se classificam para um evento especial no fim do ano, formando duplas para o
        torneio final!
      </p>

      <div class="grid grid-cols-3 gap-4">
        {
          rules.map((rule) => (
            <div class="flex flex-col sm:flex-row items-center gap-3 p-4 bg-base-100 rounded-lg">
              <div class:list={[rule.bg, "p-3 rounded-full"]}>
                <rule.icon size={24} class={rule.text} />
              </div>
              <div class="text-center md:text-left">
                <div class:list={["text-2xl font-bold", rule.text]}>+{rule.points}</div>
                <div class="text-sm text-base-content/70">{rule.label}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
