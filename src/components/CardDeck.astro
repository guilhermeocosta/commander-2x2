---
import { formatDate } from "../utils/date";
import { Calendar, User } from "@lucide/astro";
import type { Deck } from "../schemas/deck";

export type Props = Deck;

const colorsMap = {
  W: "🟡",
  U: "🔵",
  B: "⚫",
  R: "🔴",
  G: "🟢",
  C: "⚪",
};

const { player, commanders, url, record, date, colors }: Props = Astro.props;
---

<div class="card bg-base-100 shadow-xl h-full">
  <div class="card-body flex flex-col">
    <div class="flex gap-1 justify-between">
      <div class="flex gap-1">
        {colors.map((color) => <span class="text-sm">{colorsMap[color]}</span>)}
      </div>
      <div class="badge badge-neutral">
        <span class="text-sm whitespace-nowrap">{record}</span>
      </div>
    </div>

    <h4 class="sm:my-0">{commanders.join(" / ")}</h4>

    <div>
      <span class="flex items-center gap-2"><User size={16} /> {player}</span>
      <span class="flex items-center gap-2"><Calendar size={16} /> {formatDate(date)}</span>
    </div>

    <div class="card-actions mt-auto pt-4">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary btn-sm w-full no-underline"
      >
        Ver Decklist
      </a>
    </div>
  </div>
</div>
